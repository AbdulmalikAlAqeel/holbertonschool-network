#!/usr/bin/env bash
# Configures /etc/hosts to redirect localhost to 127.0.0.2 and facebook.com to 8.8.8.8

# Read the original file, modify it, and save it temporarily in /tmp
sed 's/127\.0\.0\.1 localhost/127.0.0.2 localhost/g; s/127\.0\.0\.1/127.0.0.2/g' /etc/hosts > /tmp/hosts_new

# Make sure facebook.com is added or updated
if grep -q "facebook.com" /tmp/hosts_new; then
    sed -i 's/.*facebook\.com.*/8.8.8.8 facebook.com/g' /tmp/hosts_new
else
    echo "8.8.8.8 facebook.com" >> /tmp/hosts_new
fi

# Transfer the new content directly to the original system file
cat /tmp/hosts_new > /etc/hosts
