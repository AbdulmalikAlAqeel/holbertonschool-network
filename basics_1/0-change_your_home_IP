#!/usr/bin/env bash
# Configure /etc/hosts so that localhost resolves to 127.0.0.2 and facebook.com to 8.8.8.8

# Remove old entries for localhost or facebook.com to prevent duplicates
sed -i '/localhost/d' /etc/hosts
sed -i '/facebook\.com/d' /etc/hosts

# Append the new entries to the end of the file
echo "127.0.0.2 localhost" >> /etc/hosts
echo "8.8.8.8 facebook.com" >> /etc/hosts
